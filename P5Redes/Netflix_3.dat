## Ejemplo Netflix con arcos - Data en formato AMPL

set Origenes:= S1 S2 S3;
set Destinos:= C1 C2;

set Arcos:= (S1,C1) (S2,C1) (S2,C2) (S3,C1) (S3,C2);

param Oferta:= 
       S1 3000
	   S2 2000
	   S3 2600;

param Demanda:=
       C1 3500
	   C2 4000;

param Costes :=
	S1 C1  6  
	S2 C1  2 
	S2 C2  3
	S3 C1  5
	S3 C2  4;